From 9791295c63fe2d120b14ee0685cdcbf091ac9b9f Mon Sep 17 00:00:00 2001
From: OpenAI <openai@example.com>
Date: Wed, 16 Sep 2026 10:21:21 +0000
Subject: [PATCH] fix(harmony): align curse choices and discard action


diff --git a/games/harmony/card-hand-ui.css b/games/harmony/card-hand-ui.css
index 4d7ed29..26a1eb7 100644
--- a/games/harmony/card-hand-ui.css
+++ b/games/harmony/card-hand-ui.css
@@ -445,3 +445,93 @@
   transform: none !important;
   box-shadow: 0 14px 38px #000b;
 }
+
+/* Discard-choice presentation: keep Step 4 card hierarchy intact and move the action below the card body. */
+.battle > .hand.hand-discard-choice .card-discard-shell {
+  flex: 1 0 118px;
+  width: auto;
+  min-width: 118px;
+  max-width: 155px;
+  min-height: 0;
+  display: grid;
+  grid-template-rows: minmax(0, 1fr) auto;
+  gap: 6px;
+  align-self: stretch;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  box-shadow: none;
+  color: inherit;
+  text-align: inherit;
+  cursor: pointer;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell:not([aria-disabled="true"]) > .card {
+  outline: 2px solid #9aa78b70;
+  outline-offset: 1px;
+  box-shadow: 0 0 14px #88a58b24;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell:hover:not([aria-disabled="true"]) > .card,
+.battle > .hand.hand-discard-choice .card-discard-shell:focus-visible:not([aria-disabled="true"]) > .card {
+  outline-color: #c5c9ad9c;
+  box-shadow: 0 0 18px #aebf9a38;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell > .card {
+  width: 100%;
+  min-width: 0;
+  max-width: none;
+  height: 100%;
+  min-height: 0;
+  max-height: none;
+  align-self: stretch;
+  pointer-events: none;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-action {
+  box-sizing: border-box;
+  min-height: 34px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 6px 8px;
+  border: 1px solid #9aa78b8c;
+  border-radius: 8px;
+  background: #163e344d;
+  color: #eee8d8;
+  font-size: 10px;
+  font-weight: 800;
+  line-height: 1.2;
+  letter-spacing: .01em;
+  transition: background-color .12s ease, border-color .12s ease, color .12s ease;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell:hover .card-discard-action,
+.battle > .hand.hand-discard-choice .card-discard-shell:focus-visible .card-discard-action {
+  border-color: #c5c9adad;
+  background: #24534873;
+  color: #fffaf0;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell:focus-visible {
+  outline: 2px solid #c5c9adad;
+  outline-offset: 2px;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell[aria-disabled="true"] {
+  cursor: not-allowed;
+}
+
+.battle > .hand.hand-discard-choice .card-discard-shell[aria-disabled="true"] > .card,
+.battle > .hand.hand-discard-choice .card-discard-shell[aria-disabled="true"] .card-discard-action {
+  opacity: .45;
+  filter: grayscale(.6);
+}
+
+@media (max-width: 900px) {
+  .battle > .hand.hand-discard-choice .card-discard-shell {
+    align-self: flex-start;
+    min-height: 0;
+  }
+}
diff --git a/games/harmony/card-presentation.js b/games/harmony/card-presentation.js
index 862a063..295f926 100644
--- a/games/harmony/card-presentation.js
+++ b/games/harmony/card-presentation.js
@@ -785,7 +785,12 @@ export function createCardPresentation({
       handDetailTooltip = index !== null && compactEffect === null
         ? `<span class="card-effect-tooltip" role="tooltip">${cardEffectText(card, true)}</span>`
         : "";
-   return `<button class="card card-type-${type} card-category-${category} note-${cardNote} card-tier-${tier}${compactEffect !== null ? " card-compact-status" : ""}${card.id === "impurity" ? " card-impurity" : ""}${interaction?.className ? ` ${interaction.className}` : ""}" ${interactionAttributes} ${disabled ? 'aria-disabled="true"' : ""}><span class="card-top"><b>${choosingDiscard ? (disabled ? "버리기 불가" : "이 카드 버리기") : `${apValue} AP`}</b>${card.id === "impurity" ? "" : tierStars(tier, "card-tier-stars")}<span class="card-meta"><small>${card.id === "impurity" ? "불순물" : `${{ top: "TOP", middle: "MIDDLE", base: "BASE", none: "NONE" }[cardNote]} · T${tier}`}</small>${patternBadge}${oilBadge}</span></span><span class="card-symbol" aria-hidden="true">${icon}</span>${unavailableReason ? `<span class="card-unavailable-reason" role="tooltip">${unavailableReason}</span>` : ""}<strong>${c.name}${card.level ? ` +${card.level}` : ""}</strong>${compactEffect?.symbols || ""}<span class="card-effects">${compactEffect?.body ?? cardEffectText(card)}${handDetailTooltip}</span></button>`;
+    const cardClass = `card card-type-${type} card-category-${category} note-${cardNote} card-tier-${tier}${compactEffect !== null ? " card-compact-status" : ""}${card.id === "impurity" ? " card-impurity" : ""}${interaction?.className ? ` ${interaction.className}` : ""}`,
+      cardInner = `<span class="card-top"><b>${apValue} AP</b>${card.id === "impurity" ? "" : tierStars(tier, "card-tier-stars")}<span class="card-meta"><small>${card.id === "impurity" ? "불순물" : `${{ top: "TOP", middle: "MIDDLE", base: "BASE", none: "NONE" }[cardNote]} · T${tier}`}</small>${patternBadge}${oilBadge}</span></span><span class="card-symbol" aria-hidden="true">${icon}</span>${unavailableReason ? `<span class="card-unavailable-reason" role="tooltip">${unavailableReason}</span>` : ""}<strong>${c.name}${card.level ? ` +${card.level}` : ""}</strong>${compactEffect?.symbols || ""}<span class="card-effects">${compactEffect?.body ?? cardEffectText(card)}${handDetailTooltip}</span>`;
+    if (choosingDiscard) {
+      return `<button class="card-discard-shell" ${interactionAttributes} ${disabled ? 'aria-disabled="true"' : ""}><span class="${cardClass}" ${disabled ? 'aria-disabled="true"' : ""}>${cardInner}</span><span class="card-discard-action">${disabled ? "버리기 불가" : "이 카드 버리기"}</span></button>`;
+    }
+    return `<button class="${cardClass}" ${interactionAttributes} ${disabled ? 'aria-disabled="true"' : ""}>${cardInner}</button>`;
   }
 
   return {
